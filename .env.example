# Настройте отправителя через setup-email.bat. Реальный .env не коммитится.
# Выберите один SMTP-сервис: smtp.yandex.ru / smtp.mail.ru / smtp.rambler.ru.
AURORA_EMAIL_HOST=smtp.yandex.ru
AURORA_EMAIL_PORT=465
AURORA_EMAIL_USER=sender@example.com
AURORA_EMAIL_PASSWORD=
AURORA_DEFAULT_FROM_EMAIL=sender@example.com
AURORA_EMAIL_TIMEOUT=15
